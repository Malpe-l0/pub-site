{
  "name": "pub-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib scripts tests next.config.ts proxy.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "admin:reset": "node --env-file-if-exists=.env.local scripts/admin-reset.ts",
    "site:init": "node --env-file-if-exists=.env.local scripts/init-site.ts",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.ts",
    "backup:restore": "node --env-file-if-exists=.env.local scripts/backup.ts restore",
    "maintenance": "node --env-file-if-exists=.env.local scripts/maintenance.ts",
    "test:integration": "node tests/http.integration.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
