# Primo accesso: crea automaticamente il primo titolare, solo se non esistono account.
# Almeno 12 caratteri; dopo l'inizializzazione puoi rimuovere ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=""

# Una directory persistente diversa per ciascun locale.
# DATA_DIR="/var/lib/pub-site/locale"
# BACKUP_DIR="/mnt/backup-remoto/locale"

# Facoltative: chiavi diverse per ciascun locale, 32 byte in esadecimale.
# Generazione: openssl rand -hex 32
# Se omesse, vengono generate in DATA_DIR/.keys con permessi 0600.
# APP_ENCRYPTION_KEY=""
# BACKUP_ENCRYPTION_KEY=""

# Attiva solo dietro un proxy che sovrascrive X-Real-IP (configurazione fornita).
TRUST_PROXY=0
# Limite totale delle immagini (default: 1 GiB).
MAX_UPLOAD_BYTES=1073741824
# Versione API compatibile con l'app Meta configurata; verificarla nel pannello Meta.
# Copia una versione supportata dal pannello Meta (esempio di formato: vNN.0).
INSTAGRAM_API_VERSION=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Deve coincidere esattamente con un URI autorizzato nell'app Meta.
INSTAGRAM_REDIRECT_URI="https://tuo-dominio.it/admin/instagram/callback"
